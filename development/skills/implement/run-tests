#!/usr/bin/env bash
set -u

limit="$1"
shift

log="$(mktemp "${TMPDIR:-/tmp}/run-tests.XXXXXX")"

timeout -k 1m "$limit" "$@" > "$log" 2>&1
code=$?

echo "Exit code: $code"
echo "Log: $log"
case "$code" in
  0)
    tail -n 5 "$log"
    ;;
  124 | 137)
    echo "Hit the time limit of $limit."
    tail -n 40 "$log"
    ;;
  *)
    grep -i -E -C 5 -m 50 'fail|error|✕|✗' "$log"
    echo "Last 15 lines:"
    tail -n 15 "$log"
    ;;
esac
exit "$code"
